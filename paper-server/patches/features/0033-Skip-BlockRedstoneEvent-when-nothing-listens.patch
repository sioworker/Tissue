From: sioworker <332519909+sioworker@users.noreply.github.com>
Date: Wed, 4 Nov 2026 20:55:06 +0100
Subject: [PATCH] Skip BlockRedstoneEvent when nothing listens


diff --git a/alternate/current/wire/LevelHelper.java b/alternate/current/wire/LevelHelper.java
index ff663d3089627e75221aa128aff4bf5cc459addb..4bdb0e09d9f422de645bb4a4d31f0c083696a07f 100644
--- a/alternate/current/wire/LevelHelper.java
+++ b/alternate/current/wire/LevelHelper.java
@@ -14,6 +14,7 @@ import net.minecraft.world.level.chunk.LevelChunkSection;
 class LevelHelper {
 
     static int doRedstoneEvent(ServerLevel level, BlockPos pos, int prevPower, int newPower) {
+        if (!org.bukkit.craftbukkit.event.CraftEventFactory.hasRedstoneListeners()) return newPower; // Tissue - skip event when nothing listens
         BlockRedstoneEvent event = new BlockRedstoneEvent(CraftBlock.at(level, pos), prevPower, newPower);
         level.getCraftServer().getPluginManager().callEvent(event);
 
diff --git a/net/minecraft/world/level/block/ComparatorBlock.java b/net/minecraft/world/level/block/ComparatorBlock.java
